# Copiar a .env.local y completar. .env.local NO se sube a git.
# URL de conexión de Neon (Dashboard > Connect > "Pooled connection"):
DATABASE_URL=
# Token del Blob store de Vercel (Storage > tu store > .env.local). Sin él, las imágenes se guardan en public/uploads/.
BLOB_READ_WRITE_TOKEN=
# Dominio(s) del dashboard, separados por coma (ej: dlcritic-admin.vercel.app). Si se define, ese dominio sirve SOLO el
# panel de administración y todos los demás SOLO el sitio público. Sin definir (local), un único dominio sirve todo.
ADMIN_HOST=
# Dirección pública del sitio (ej: https://dlcritic.vercel.app). Va en los enlaces de los correos; en producción es obligatoria.
PUBLIC_URL=
# Envío de correos (recuperación de contraseña), por SMTP. Sin SMTP_HOST, en local los correos se imprimen en la consola; en producción fallan.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=tu_cuenta@gmail.com y SMTP_PASS=una "contraseña de aplicación" de Google (no la de la cuenta).
SMTP_HOST=
SMTP_PORT=465
# tls (puerto 465), starttls (puerto 587) o none (solo hacia localhost); si se omite se elige según el puerto.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Remitente, ej: DLCritic <dlcriticweb@gmail.com> (por defecto, SMTP_USER) y, si se quiere, a dónde van las respuestas.
MAIL_FROM=
MAIL_REPLY_TO=

# Iniciar sesion con Google (opcional; sin estas dos variables el boton no aparece). Se crean en Google Cloud Console > APIs y servicios > Credenciales >
# ID de cliente de OAuth (Aplicacion web), con la URI de redireccionamiento autorizada PUBLIC_URL + /api/auth/google/callback. Mas detalles en el README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
