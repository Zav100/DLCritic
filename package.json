{
  "name": "cartridge",
  "version": "1.0.0",
  "private": true,
  "description": "DLCritic - catalogo y resenas de videojuegos",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch --env-file-if-exists=.env.local server/index.js",
    "dev:local": "node --watch -r ./scripts/local-env.js server/index.js",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.js",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed.js",
    "db:backup": "node --env-file=.env.backup scripts/backup.js",
    "db:restore": "node --env-file-if-exists=.env.local scripts/restore.js",
    "db:import": "node --env-file-if-exists=.env.local scripts/import-sqlite.js",
    "make-admin": "node --env-file-if-exists=.env.local server/make-admin.js",
    "make-subscriber": "node --env-file-if-exists=.env.local server/make-subscriber.js",
    "db:reset-2fa": "node --env-file-if-exists=.env.local scripts/reset-2fa.js",
    "test:smoke": "node --env-file-if-exists=.env.local scripts/smoke-test.js",
    "db:migrate-uploads": "node --env-file-if-exists=.env.local scripts/migrate-uploads.js"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@neon/config": "^1.10.0",
    "@neon/env": "^1.6.8"
  }
}
